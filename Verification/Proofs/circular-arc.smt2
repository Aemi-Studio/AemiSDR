(define-fun pos ((x Real)) Real (mx x 0))
(define-fun mn ((x Real)(y Real)) Real (- (mx (- x) (- y))))
(define-fun f ((x Real)(y Real)(n Real)) Real (+ n (mn (mx x y) 0)))
(declare-const h Real)
(declare-const scale Real)
(declare-const depth Real)
(assert (and (> scale 0)(>= h (/ 1 1000))(>= (* h scale) (/ 1 1000))))
(assert (not (= (mn (mx (/ depth (mx h (/ 1 1000))) 0) 1)
(mn (mx (/ (* depth scale) (mx (* h scale) (/ 1 1000))) 0) 1))))
(check-sat)
(reset)
